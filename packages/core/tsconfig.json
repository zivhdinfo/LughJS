{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    // src/ is not published, so the maps must carry the sources with them.
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src"]
}
