{
  "name": "@lughjs/core",
  "version": "2.0.0",
  "description": "Structure for Node HTTP services: MVC layout, a boot-time container, migrations and a project scaffolder",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "lugh": "./bin/lugh.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "awilix": "^8.0.1",
    "commander": "^13.0.0",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "fastify": "^5.0.0",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "framework",
    "mvc",
    "http",
    "api",
    "scaffold",
    "migrations",
    "dependency-injection",
    "knex",
    "objection"
  ],
  "license": "MIT"
}
