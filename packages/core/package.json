{
  "name": "@lughjs/core",
  "version": "2.0.0",
  "description": "Structure for Node HTTP services: MVC layout, a boot-time container, migrations and a project scaffolder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "lugh-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "lugh-dev": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lugh": "./bin/lugh.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --conditions=lugh-dev --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "awilix": "^8.0.1",
    "commander": "^13.0.0",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "fastify": "^5.0.0",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "framework",
    "mvc",
    "http",
    "api",
    "scaffold",
    "migrations",
    "dependency-injection",
    "knex",
    "objection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zivhdinfo/LughJS.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zivhdinfo/LughJS#readme",
  "bugs": {
    "url": "https://github.com/zivhdinfo/LughJS/issues"
  },
  "license": "MIT"
}
